{
  "name": "grok-web",
  "version": "0.10.0",
  "description": "Local browser workspace for Grok Build",
  "author": "icekale",
  "license": "MIT",
  "homepage": "https://github.com/icekale/grok-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icekale/grok-web.git"
  },
  "bugs": {
    "url": "https://github.com/icekale/grok-web/issues"
  },
  "keywords": [
    "grok",
    "coding-agent",
    "local-first",
    "acp",
    "tanstack"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "grok-web": "bin/grok-web.js"
  },
  "files": [
    "bin",
    ".output",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite dev --configLoader runner --config vite.tanstack.config.ts --host 127.0.0.1 --port 30142",
    "dev:lan": "vite dev --configLoader runner --config vite.tanstack.config.ts --host 0.0.0.0 --port 30142",
    "build": "node scripts/pack-tanstack.mjs",
    "start": "node bin/grok-web.js --no-open -H 127.0.0.1 -p 30142",
    "start:lan": "node bin/grok-web.js --no-open -H 0.0.0.0 -p 30142",
    "build:tanstack": "vite build --configLoader runner --config vite.tanstack.config.ts",
    "build:tanstack:standalone": "GROK_WEB_TANSTACK_OUTPUT_MODE=standalone vite build --configLoader runner --config vite.tanstack.config.ts",
    "build:tanstack:publication": "GROK_WEB_TANSTACK_OUTPUT_MODE=publication vite build --configLoader runner --config vite.tanstack.config.ts",
    "pack:tanstack": "node scripts/pack-tanstack.mjs",
    "start:tanstack": "node scripts/start-tanstack-output.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/reject-root-publish.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\" \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "shot": "node scripts/update-readme-screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.42",
    "js-yaml": "^5.2.3",
    "lucide-react": "^0.562.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@lobehub/icons": "^5.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "nitro": "3.0.260311-beta",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "typescript-eslint": "8.57.1",
    "vite": "8.2.1"
  }
}
